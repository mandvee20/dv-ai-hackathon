          }
        },
        {
          "deviceId": "2",
          "deviceType": "LIGHT",
          "operations": {
            "ON": {
              "result": "FAILURE",
              "exception": "NoRouteToHostException",
              "message": "No Route To Host",
              "description": "IP is not reachable."
            }
          }
        },
        {
          "deviceId": "3",
          "deviceType": "CURTAIN",
          "operations": {
            "OPEN": {
              "result": "FAILURE",
              "exception": "SocketException",
              "message": "Network is unreachable",
              "description": "Network is not reachable. Check network connection."
            }
          }
        },
        {
          "deviceId": "4",
          "deviceType": "LIGHT",
          "protocol": "KNX",
