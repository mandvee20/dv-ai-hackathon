            "ON": {
              "result": "FAILURE",
              "exception": "KnxSecureException",
              "message": "secure session authorization failed",
              "description": "Incorrect UserId, Password or Device Auth Code.",
              "possibleCauses": [
                "Incorrect UserId",
                "Incorrect Password",
                "Incorrect Device Auth Code",
                "Corrupted KNX keyring"
              ],
              "recommendedAction": [
                "Verify configured credentials",
                "Regenerate keyring file if corrupted"
              ]
            }
          }
        }
      ]
    },

    {
      "roomId": "420",
      "dvc": {
        "ip": "10.10.10.12",
        "port": 9010,
        "health": {
          "threadCount": 700,
          "baselineThreadCount": 80,
          "threadThreshold": 500,
          "memoryUsage": "HIGH",
          "memoryThresholdPercent": 80,
          "totalMemoryMb": 8500,
          "baselineMemoryMb": 5200,
          "memoryLeak": true
